#!/usr/bin/env python
"""
tistools-memory-analysis: crossing-probability profile and memory-effect
analysis for iSTAR/StapleTIS simulations.

Computes:
  - The crossing-probability profile P_A(lambda_i | lambda_A) as a function of
    lambda, from the iSTAR Markov state model (StapleTIS), compared with the
    REPPTIS and milestoning estimates built from the same ensembles' local
    crossing probabilities, plus their ratio to StapleTIS. No time-reversal
    reweighting is applied. Error bars: StapleTIS from --pcross-errors,
    REPPTIS/milestoning from a block bootstrap over cycles (--error-blocks).
  - Memory-effect (non-Markovian) analysis of the conditional crossing
    probabilities between interfaces, with the associated diagnostic plots.

Usage:
    tistools-memory-analysis <simulation_dir> [options]

Example:
    tistools-memory-analysis /path/to/staple_sim --show
"""

import argparse
import contextlib
import glob
import io
import os
import sys
# A sibling project (inftools) puts a directory containing its own empty
# `tistools` namespace package on sys.path; strip it so `import tistools`
# below resolves to the real, pip-installed (editable) tistools package
# instead of that empty shadow.
sys.path = [p for p in sys.path if 'inftools' not in p]
from pathlib import Path

import numpy as np


def parse_args():
    parser = argparse.ArgumentParser(
        description="Crossing-probability profile and memory-effect analysis for iSTAR/StapleTIS simulations.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "simdir",
        type=str,
        help="Path to the simulation directory containing ensemble folders (000, 001, ...)",
    )
    parser.add_argument(
        "--inputfile",
        type=str,
        default=None,
        help="Path to input file (default: <simdir>/logging.log)",
    )
    parser.add_argument(
        "--zero-minus-one",
        action="store_true",
        default=False,
        help="Set if lambda_-1 interface is defined",
    )
    parser.add_argument(
        "--q-errors",
        type=str,
        default=None,
        help="Path to a block-error-analysis text file with errors for the q-matrix "
             "(e.g. block_error_analysis_qstaple_1.txt), used to draw error bars/bands "
             "on the memory-analysis and memory-landscape plots (default: none)",
    )
    parser.add_argument(
        "--pcross-errors",
        type=str,
        default=None,
        help="Path to the StapleTIS P_cross block-error file from tistools-running-error-staple "
             "(block_error_analysis_Pcross_<interval>.txt), used for the StapleTIS error bars "
             "(default: none)",
    )
    parser.add_argument(
        "--error-blocks",
        type=int,
        default=20,
        help="Number of cycle blocks for the REPPTIS/milestoning block bootstrap; blocks must "
             "be longer than the correlation time. 0 disables these error bars (default: 20)",
    )
    parser.add_argument(
        "--boot-samples",
        type=int,
        default=1000,
        help="Number of block-bootstrap resamples (default: 1000)",
    )
    parser.add_argument(
        "--outdir",
        type=str,
        default=None,
        help="Directory to save plots in (default: <simdir>)",
    )
    parser.add_argument(
        "--show",
        action="store_true",
        help="Also display the plots interactively (in addition to saving them)",
    )
    return parser.parse_args()


PATHTYPES = ("LMR", "LML", "RMR", "RML")


def local_probs_from_weights(w):
    """Same estimator as get_local_probs(tr=False), from summed path-type weights."""
    wL, wR = w["LMR"] + w["LML"], w["RMR"] + w["RML"]
    w_tot = wL + wR
    ratio = lambda a, b: a / b if b != 0 else np.nan
    return {
        "LMR": ratio(w["LMR"], wL), "LML": ratio(w["LML"], wL),
        "RMR": ratio(w["RMR"], wR), "RML": ratio(w["RML"], wR),
        "2R": ratio(w["LMR"] + w["RMR"], w_tot), "2L": ratio(w["LML"] + w["RML"], w_tot),
    }


def repptis_mlst_pcross(ploc):
    """REPPTIS and milestoning P_cross profiles, as in ploc_memory.

    ploc[i] holds the local probabilities of ensemble i; ploc[0] ([0-]) is unused.
    """
    from tistools import get_global_probs_from_dict, construct_M_milestoning, global_pcross_msm

    _, _, pc_rep = get_global_probs_from_dict(ploc)
    pc_mlst = [1.0, ploc[1]["LMR"]]
    for lint in range(3, len(ploc) + 1):
        p_min = [ploc[r]["2L"] for r in range(1, lint)]
        p_plus = [ploc[r]["2R"] for r in range(1, lint)]
        try:
            _, _, y1, _ = global_pcross_msm(construct_M_milestoning(p_min, p_plus, lint))
            pc_mlst.append(y1[0][0])
        except (np.linalg.LinAlgError, ValueError):
            pc_mlst.append(np.nan)
    return np.array(pc_rep, dtype=float), np.array(pc_mlst, dtype=float)


def block_bootstrap_repptis_mlst(pathensembles, n_blocks, n_boot, seed=0):
    """Block bootstrap of the REPPTIS and milestoning P_cross profiles.

    Cycles are cut into n_blocks contiguous blocks, shared by all ensembles so
    the replica-exchange coupling between them is kept. Each resample draws
    whole blocks with replacement and re-evaluates the profiles from the summed
    LMR/LML/RMR/RML weights (accepted, non-load paths, as get_local_probs).
    Returns the bootstrap samples, shape (n_boot, n_int) for each method.
    """
    from tistools import get_lmr_masks, get_flag_mask, get_generation_mask

    ens = pathensembles[1:]
    cmin = min(np.min(pe.cyclenumbers) for pe in ens)
    cmax = max(np.max(pe.cyclenumbers) for pe in ens)
    edges = np.linspace(cmin, cmax + 1, n_blocks + 1)
    W = np.zeros((len(ens), n_blocks, len(PATHTYPES)))
    for e, pe in enumerate(ens):
        masks = get_lmr_masks(pe)
        use = get_flag_mask(pe, "ACC") & ~get_generation_mask(pe, "ld")
        blk = np.clip(np.searchsorted(edges, pe.cyclenumbers, side="right") - 1, 0, n_blocks - 1)
        w = np.asarray(pe.weights, dtype=float)
        for k, t in enumerate(PATHTYPES):
            m = masks[t] & use
            W[e, :, k] = np.bincount(blk[m], weights=w[m], minlength=n_blocks)

    rng = np.random.default_rng(seed)
    rep, mlst = [], []
    for _ in range(n_boot):
        counts = np.bincount(rng.integers(n_blocks, size=n_blocks), minlength=n_blocks)
        sums = np.einsum("b,ebt->et", counts, W)
        ploc = [None] + [local_probs_from_weights(dict(zip(PATHTYPES, s))) for s in sums]
        r, m = repptis_mlst_pcross(ploc)
        rep.append(r)
        mlst.append(m)
    return np.array(rep), np.array(mlst)


def asym_err(center, samples):
    """16-84 percentile error bars around center (sensible on a log axis)."""
    lo, hi = np.nanpercentile(samples, [16, 84], axis=0)
    return np.vstack([np.clip(center - lo, 0, None), np.clip(hi - center, 0, None)])


def main():
    args = parse_args()

    try:
        from tistools import (
            read_inputfile,
            get_LMR_interfaces,
            read_pathensemble,
            get_weights,
            ACCFLAGS,
            REJFLAGS,
        )
        from tistools import (
            display_data,
            get_transition_probs_weights,
            compute_weight_matrices,
            construct_M_istar,
            global_pcross_msm_star,
            memory_analysis,
            get_local_probs,
            read_block_rel_errors,
        )
        from tistools import plot_memory_analysis, plot_memory_landscape
    except ImportError as e:
        print(f"Error: Could not import tistools: {e}", file=sys.stderr)
        print("Make sure tistools is installed or in your PYTHONPATH.", file=sys.stderr)
        sys.exit(1)

    import matplotlib

    if not args.show:
        matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    simdir = Path(args.simdir).resolve()
    if not simdir.exists():
        print(f"Error: Directory {simdir} does not exist", file=sys.stderr)
        sys.exit(1)

    outdir = Path(args.outdir).resolve() if args.outdir else simdir
    outdir.mkdir(parents=True, exist_ok=True)

    inputfile = args.inputfile or str(simdir / "logging.log")
    if not os.path.exists(inputfile):
        print(f"Error: Input file not found: {inputfile}", file=sys.stderr)
        sys.exit(1)

    folders = sorted(glob.glob(str(simdir / "0[0-9][0-9]")))
    if not folders:
        print(f"Error: No ensemble folders found in {simdir}", file=sys.stderr)
        sys.exit(1)

    # ---------------------------------------------------------------------
    # Reading
    # ---------------------------------------------------------------------
    interfaces, zero_left, timestep = read_inputfile(inputfile)
    LMR_interfaces, LMR_strings = get_LMR_interfaces(interfaces, zero_left)
    n_int = len(interfaces)

    pathensembles = []
    for i, fol in enumerate(folders):
        pe = read_pathensemble(os.path.join(fol, "pathensemble.txt"))
        pe.set_name(fol)
        pe.set_interfaces([LMR_interfaces[i], LMR_strings[i]])
        if i == 0:
            pe.set_zero_minus_one(args.zero_minus_one)
            pe.set_in_zero_minus(True)
        if i == 1:
            pe.set_in_zero_plus(True)

        w, _ = get_weights(pe.flags, ACCFLAGS, REJFLAGS, verbose=False)
        pe.set_weights(w)

        # Order parameters (order.txt/order.npy) are not needed for the
        # crossing-probability or memory analysis below. Uncomment if you
        # also need them (load=True after the first run to read the cached
        # .npy files instead of the raw order.txt):
        # pe.set_orders(load=False, acc_only=True, save=True)

        pathensembles.append(pe)

    print(f"Loaded {len(pathensembles)} path ensembles from {simdir}")

    # ---------------------------------------------------------------------
    # Crossing-probability profile
    # ---------------------------------------------------------------------
    # Like ploc_memory: no time-reversal reweighting, no HA correction.
    plocMSM = np.ones(n_int)
    for lint in range(2, n_int + 1):
        wi = compute_weight_matrices(pathensembles[:lint], interfaces[:lint], n_int, tr=False,
                                     correct_ha=False, norm=False)
        pi, _ = get_transition_probs_weights(wi)
        Mi = construct_M_istar(pi, max(4, 2 * len(interfaces[:lint])), len(interfaces[:lint]))
        _, _, y1, _ = global_pcross_msm_star(Mi)
        plocMSM[lint - 1] = y1[0][0]
        print(f"ploc till intf {lint - 1}: {y1[0][0]}")

    # REPPTIS and milestoning from the same ensembles' local LMR/LML/RMR/RML
    # probabilities: REPPTIS chains them with a Markov jump at each interface,
    # milestoning additionally forgets the direction a path arrived from.
    # get_local_probs prints its weights for every ensemble, so silence it.
    with contextlib.redirect_stdout(io.StringIO()):
        ploc_rep = [None] + [get_local_probs(pe, w=pe.weights, tr=False) for pe in pathensembles[1:]]
        pc_rep, pc_mlst = repptis_mlst_pcross(ploc_rep)

    stap_err = None
    if args.pcross_errors:
        # Stored errors are relative (abs_err / estimate); scale to absolute.
        stap_err = read_block_rel_errors(args.pcross_errors, (n_int,)) * plocMSM
    rep_err = mlst_err = None
    if args.error_blocks > 0:
        print(f"Block bootstrap of REPPTIS/milestoning P_cross: {args.error_blocks} blocks, "
              f"{args.boot_samples} resamples")
        boot_rep, boot_mlst = block_bootstrap_repptis_mlst(
            pathensembles, args.error_blocks, args.boot_samples)
        rep_err, mlst_err = asym_err(pc_rep, boot_rep), asym_err(pc_mlst, boot_mlst)

    def fmt_err(err, i):
        return "" if err is None else f" (-{err[0][i]:.1e}/+{err[1][i]:.1e})" if err.ndim == 2 \
            else f" (±{err[i]:.1e})"

    print("P_cross per interface: StapleTIS | REPPTIS | milestoning")
    for i in range(n_int):
        print(f"  intf {i} (lambda={interfaces[i]:g}): "
              f"{plocMSM[i]:.4e}{fmt_err(stap_err, i)} | {pc_rep[i]:.4e}{fmt_err(rep_err, i)} | "
              f"{pc_mlst[i]:.4e}{fmt_err(mlst_err, i)}")

    lam = np.asarray(interfaces, dtype=float)
    fig, (ax, axr) = plt.subplots(2, 1, sharex=True, figsize=(7, 6.5),
                                  gridspec_kw={"height_ratios": [3, 1.4]})
    ax.set_yscale("log")
    curves = [("StapleTIS", plocMSM, stap_err, "-o", "b"),
              ("REPPTIS", pc_rep, rep_err, "-s", "orange"),
              ("Milestoning", pc_mlst, mlst_err, "-^", "r")]
    for label, pc, err, fmt, c in curves:
        ax.errorbar(lam, pc, yerr=err, fmt=fmt, c=c, capsize=4, label=label)
    ax.set_ylabel(r"$P_A(\lambda_i|\lambda_A)$")
    ax.legend()
    top = ax.secondary_xaxis("top")
    top.set_xticks(lam, labels=[str(i) for i in range(n_int)])
    top.set_xlabel("Interface index")

    # Ratio to StapleTIS: where and how much the Markov-jump estimates drift off.
    # Relative errors are combined in quadrature (treated as independent).
    stap_rel = np.zeros(n_int) if stap_err is None else stap_err / plocMSM
    axr.axhline(1.0, c="b", lw=1, ls="--")
    with np.errstate(divide="ignore", invalid="ignore"):
        for label, pc, err, fmt, c in curves[1:]:
            ratio = np.where(plocMSM > 0, pc / plocMSM, np.nan)
            own_rel = np.zeros(n_int) if err is None else 0.5 * (err[0] + err[1]) / pc
            ratio_err = None if err is None and stap_err is None else \
                np.abs(ratio) * np.hypot(own_rel, stap_rel)
            axr.errorbar(lam, ratio, yerr=ratio_err, fmt=fmt, c=c, capsize=3, ms=4, label=label)
    axr.set_ylabel("ratio to StapleTIS")
    axr.set_xlabel(r"$\lambda$")
    fig.tight_layout()
    crossing_plot_file = outdir / "crossing_probability_profile.png"
    fig.savefig(crossing_plot_file, dpi=200)
    print(f"Crossing-probability profile saved to {crossing_plot_file}")

    # ---------------------------------------------------------------------
    # Memory analysis
    # ---------------------------------------------------------------------
    C, X_tr, X_norm, X_tr_norm, wpath, W_tr, W_norm, W_tr_norm, W = display_data(
        pathensembles, interfaces, n_int, correct_ha=False
    )
    p, q = get_transition_probs_weights(wpath)
    q_k, q_tot = memory_analysis(wpath, False)
    fig1, fig2, fig3, fig4 = plot_memory_analysis(pathensembles, q_tot, p, interfaces, q_errors=args.q_errors)

    memory_files = {
        "memory_matrices.png": fig1,
        "memory_probabilities.png": fig2,
        "free_energy_momentum.png": fig3,
        # q(i,k) on its own canvas: it is the panel that has to stay readable
        # when the simulation has many interfaces.
        "q_matrix.png": fig4,
    }
    for fname, mfig in memory_files.items():
        fpath = outdir / fname
        mfig.savefig(fpath, dpi=200)
        print(f"Memory analysis plot saved to {fpath}")

    # Memory index and conditional probabilities over the order parameter landscape
    fig_landscape, _ = plot_memory_landscape(interfaces, q_tot, q_errors=args.q_errors)
    landscape_file = outdir / "memory_landscape.png"
    fig_landscape.savefig(landscape_file, dpi=200)
    print(f"Memory landscape plot saved to {landscape_file}")

    if args.show:
        plt.show()


if __name__ == "__main__":
    main()
